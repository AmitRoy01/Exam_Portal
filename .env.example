# Server configuration — NO Google OAuth or Drive API credentials required.
# Local: copy this file to .env. Netlify: add these under Site configuration → Environment variables.
PORT=3001
# Optional. Base URL used in the student share links. If empty, the current site's domain is used.
PUBLIC_URL=http://localhost:3001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/drive_mcq?retryWrites=true&w=majority
# Production requires at least 12 characters.
ADMIN_PASSWORD=choose-a-long-random-admin-password
# Production requires at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
# Vercel only: protects /api/cron/auto-grade (Vercel Cron sends it automatically). Required in production on Vercel.
CRON_SECRET=
# Use development locally. On Netlify, set production (or leave unset — functions default to production).
NODE_ENV=development
