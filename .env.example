# Server configuration — NO Google OAuth or Drive API credentials required.
PORT=3001
PUBLIC_URL=http://localhost:3001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/drive_mcq?retryWrites=true&w=majority
ADMIN_PASSWORD=choose-a-long-random-admin-password
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
NODE_ENV=development
